    "proteinDescription": {
        "recommendedName": {
            "fullName": {
                "value": "Odorant receptor 30a"
            }
        }
    },
    "genes": [
        {
            "geneName": {
                "value": "Or30a"
            },
            "orfNames": [
                {
                    "value": "CG13106"
                }
